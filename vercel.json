{
  "builds": [
    {
      "src": "api/cron.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "algorithms/*.cpp"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/cron",
      "dest": "/api/cron.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 8 * * *"
    }
  ]
}
